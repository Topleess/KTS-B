PENDING_ACTION_TTL_MINUTES="1440"
ALLOW_DEV_AUTH="true"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_NOTIFICATIONS_ENABLED="true"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
WEATHER_PROVIDER="open-meteo"
WEATHER_TIMEOUT_SECONDS="4"
PRICE_SOURCES_URL=""

JOBS_SCHEDULER_TICK_SECONDS="30"
JOB_PRICE_COLLECTION_INTERVAL_SECONDS="3600"
JOB_PRICE_ALERTS_INTERVAL_SECONDS="300"
JOB_PRODUCT_LOW_INTERVAL_SECONDS="21600"
JOB_ENVIRONMENT_EVENTS_INTERVAL_SECONDS="10800"
JOB_ROUTINE_NOTIFICATIONS_INTERVAL_SECONDS="3600"
JOB_OBSERVATION_FOLLOWUPS_INTERVAL_SECONDS="3600"
JOB_NOTIFICATION_DISPATCH_INTERVAL_SECONDS="120"
