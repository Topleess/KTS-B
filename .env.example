NEXT_PUBLIC_API_BASE_URL="/api/v1"
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

APP_ENV="development"
FRONTEND_ORIGIN="http://localhost:3000"
