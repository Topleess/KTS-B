{
  "name": "kts-beauty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd backend && ../.venv/bin/uvicorn app.main:app --reload --port 8000",
    "dev:api:sqlite": "cd backend && APP_ENV=development DATABASE_URL=sqlite+aiosqlite:///../.data/cosmeto.db ../.venv/bin/uvicorn app.main:app --reload --port 8000",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "cd backend && ../.venv/bin/alembic upgrade head",
    "db:init:sqlite": "cd backend && APP_ENV=development DATABASE_URL=sqlite+aiosqlite:///../.data/cosmeto.db ../.venv/bin/python scripts/init_sqlite.py",
    "jobs:run:sqlite": "cd backend && APP_ENV=development DATABASE_URL=sqlite+aiosqlite:///../.data/cosmeto.db ../.venv/bin/python scripts/run_workers_once.py",
    "jobs:scheduler": "cd backend && ../.venv/bin/python scripts/run_scheduler.py",
    "jobs:scheduler:sqlite": "cd backend && APP_ENV=development DATABASE_URL=sqlite+aiosqlite:///../.data/cosmeto.db ../.venv/bin/python scripts/run_scheduler.py",
    "test:api": "cd backend && ../.venv/bin/pytest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.11",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.67.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3"
  }
}
