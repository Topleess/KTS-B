POSTGRES_DB=cosmeto
POSTGRES_USER=cosmeto
POSTGRES_PASSWORD=replace-with-strong-postgres-password

NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_APP_URL=https://kts.as-shamshurin.xyz
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
API_PROXY_TARGET=http://backend:8000

# Smoke-test default. Switch to production only after setting TELEGRAM_BOT_TOKEN,
# a strong JWT_SECRET, JOBS_ADMIN_TOKEN, and ALLOW_DEV_AUTH=false.
APP_ENV=development
FRONTEND_ORIGIN=https://kts.as-shamshurin.xyz
ALLOW_DEV_AUTH=true

DATABASE_URL=postgresql+asyncpg://cosmeto:replace-with-strong-postgres-password@postgres:5432/cosmeto
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
PENDING_ACTION_TTL_MINUTES=1440

TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATIONS_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WEATHER_PROVIDER=open-meteo
WEATHER_TIMEOUT_SECONDS=4
PRICE_SOURCES_URL=

JOBS_SCHEDULER_TICK_SECONDS=30
JOB_PRICE_COLLECTION_INTERVAL_SECONDS=3600
JOB_PRICE_ALERTS_INTERVAL_SECONDS=300
JOB_PRODUCT_LOW_INTERVAL_SECONDS=21600
JOB_ENVIRONMENT_EVENTS_INTERVAL_SECONDS=10800
JOB_ROUTINE_NOTIFICATIONS_INTERVAL_SECONDS=3600
JOB_OBSERVATION_FOLLOWUPS_INTERVAL_SECONDS=3600
JOB_NOTIFICATION_DISPATCH_INTERVAL_SECONDS=120
JOBS_ADMIN_TOKEN=replace-with-strong-admin-token-before-production

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/uploads
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
